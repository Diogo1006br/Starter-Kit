# Copy to .env (done by `make init`, which also fills the blank secrets).
# .env is git-ignored. Never commit real credentials.

# --- Project -----------------------------------------------------------------
# Namespaces containers, networks and volumes. Lowercase letters, digits, "-".
COMPOSE_PROJECT_NAME=starter
APP_NAME=Starter
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Generated by `make init` (php artisan key:generate --show).
APP_KEY=

# --- Host ports (change them to run several projects side by side) -----------
BACKEND_PORT=8080
FRONTEND_PORT=5174
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6390

# --- PostgreSQL --------------------------------------------------------------
DB_DATABASE=app
DB_USERNAME=app
# Generated by `make init` when blank.
DB_PASSWORD=

# --- Redis -------------------------------------------------------------------
# Generated by `make init` when blank.
REDIS_PASSWORD=

# --- Laravel -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

# --- Docker / tooling --------------------------------------------------------
# Host user ids so bind-mounted files are not owned by root. Set by `make init`.
HOST_UID=
HOST_GID=
# Set to true if Vite HMR does not pick up file changes inside Docker.
CHOKIDAR_USEPOLLING=false
